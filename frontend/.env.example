# Copy to frontend/.env.local. Never put secrets in NEXT_PUBLIC_* variables: they are
# embedded in the browser bundle at build time.

# Base URL of the Django API (no trailing slash).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Server-only setting (no NEXT_PUBLIC_ prefix): where the Next.js proxy route forwards
# /api/backend/* requests. The proxy holds no secret; users sign in with a Django session.
API_BASE_URL=http://localhost:8000
