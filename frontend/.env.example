# Copy to frontend/.env.local. Never put secrets in NEXT_PUBLIC_* variables: they are
# embedded in the browser bundle at build time.

# Base URL of the Django API (no trailing slash).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Server-only settings (no NEXT_PUBLIC_ prefix): used by the Next.js proxy route and
# never sent to the browser.
API_BASE_URL=http://localhost:8000
# Must match COLLECTFLOW_OPERATOR_TOKEN in backend/.env.
COLLECTFLOW_OPERATOR_TOKEN=
