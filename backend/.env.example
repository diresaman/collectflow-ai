# Copy to backend/.env and adjust for your machine. Never commit the real .env file.

# Set to true for local development only.
DJANGO_DEBUG=true

# Required when DJANGO_DEBUG=false. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=

# Comma-separated list of hostnames Django may serve.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated list of frontend origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# SQLite database file, relative to the backend directory.
SQLITE_PATH=db.sqlite3

# Local timezone used to decide whether an invoice is overdue (e.g. Africa/Addis_Ababa).
DJANGO_TIME_ZONE=UTC

# Shared secret protecting business endpoints. Must match COLLECTFLOW_OPERATOR_TOKEN
# in frontend/.env.local. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
COLLECTFLOW_OPERATOR_TOKEN=

# Google Sheets invoice source (read-only access).
# The ID is the long string in the sheet URL: docs.google.com/spreadsheets/d/<ID>/edit
GOOGLE_SHEETS_SPREADSHEET_ID=
# A1 range including the header row, e.g. Sheet1!A1:G or Invoices!A1:G
GOOGLE_SHEETS_RANGE=Sheet1!A1:G
# Path to the service account JSON key (relative paths resolve from backend/).
# Keep the key inside backend/credentials/, which is gitignored.
GOOGLE_APPLICATION_CREDENTIALS=credentials/google-service-account.json

# Gemini API for AI-drafted payment reminders (server-side only).
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Gmail sending (OAuth 2.0, gmail.send scope only; never reads mail).
# 1. Google Cloud Console: enable the Gmail API, create an OAuth client of type "Desktop app",
#    download its JSON to the path below. 2. Run: python manage.py authorize_gmail
GMAIL_OAUTH_CLIENT_FILE=credentials/gmail-oauth-client.json
# Written by authorize_gmail (gitignored, permissions 600). Never commit it.
GMAIL_TOKEN_FILE=credentials/gmail-token.json
# The dedicated Gmail account that authorizes sending (must match the authorized account).
GMAIL_SENDER_EMAIL=
# Who may be emailed: comma-separated addresses and/or @domains you control.
# Required while DJANGO_DEBUG=true; with it empty in development, every send is refused.
GMAIL_ALLOWED_RECIPIENTS=

# Proactive automation (python manage.py run_automation / Run Automation button).
# Days after a confirmed SENT (or rejected) reminder before a new draft is generated.
FOLLOWUP_COOLDOWN_DAYS=7
# Maximum Gemini drafts per run.
AUTOMATION_MAX_DRAFTS_PER_RUN=10
# Run lease in seconds, renewed after every step; a crashed run's lease expires after this.
AUTOMATION_LEASE_SECONDS=600
