# Copy to backend/.env and adjust for your machine. Never commit the real .env file.

# Set to true for local development only.
DJANGO_DEBUG=true

# Required when DJANGO_DEBUG=false. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=

# Comma-separated list of hostnames Django may serve.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated list of frontend origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# PostgreSQL 16. Docker Compose creates the database from these values and points the api and
# worker containers at the `db` service (host db, port 5432) by itself. The values below are for
# running manage.py, tests or cron on the host against the Compose database, which is published
# on 127.0.0.1:${POSTGRES_HOST_PORT:-5433}. Generate a password with:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_DB=collectflow
POSTGRES_USER=collectflow
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
# Seconds a connection is reused (0 = close after each request).
POSTGRES_CONN_MAX_AGE=60

# Local timezone used to decide whether an invoice is overdue (e.g. Africa/Addis_Ababa).
DJANGO_TIME_ZONE=UTC

# Users sign in with a session (create them with: python manage.py create_user <name> --role ROLE).
# Session/CSRF cookies get the Secure flag unless DJANGO_DEBUG=true; override with SECURE_COOKIES.
# SECURE_COOKIES=false
# Session lifetime in seconds (default 12 hours).
SESSION_COOKIE_AGE=43200
# Failed logins per username within the window before further attempts get HTTP 429.
LOGIN_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW_SECONDS=900
# Mount the Django admin at /admin/ (off by default).
ENABLE_ADMIN=false

# Google Sheets invoice source (read-only access).
# The ID is the long string in the sheet URL: docs.google.com/spreadsheets/d/<ID>/edit
GOOGLE_SHEETS_SPREADSHEET_ID=
# A1 range including the header row, e.g. Sheet1!A1:G or Invoices!A1:G
GOOGLE_SHEETS_RANGE=Sheet1!A1:G
# Path to the service account JSON key (relative paths resolve from backend/).
# Keep the key inside backend/credentials/, which is gitignored.
GOOGLE_APPLICATION_CREDENTIALS=credentials/google-service-account.json

# Gemini API for AI-drafted payment reminders (server-side only).
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Gmail sending (OAuth 2.0, gmail.send scope only; never reads mail).
# 1. Google Cloud Console: enable the Gmail API, create an OAuth client of type "Desktop app",
#    download its JSON to the path below. 2. Run: python manage.py authorize_gmail
GMAIL_OAUTH_CLIENT_FILE=credentials/gmail-oauth-client.json
# Written by authorize_gmail (gitignored, permissions 600). Never commit it.
GMAIL_TOKEN_FILE=credentials/gmail-token.json
# The dedicated Gmail account that authorizes sending (must match the authorized account).
GMAIL_SENDER_EMAIL=
# Who may be emailed: comma-separated addresses and/or @domains you control.
# Required while DJANGO_DEBUG=true; with it empty in development, every send is refused.
GMAIL_ALLOWED_RECIPIENTS=

# Proactive automation (python manage.py run_automation / Run Automation button).
# Days after a confirmed SENT (or rejected) reminder before a new draft is generated.
FOLLOWUP_COOLDOWN_DAYS=7
# Maximum Gemini drafts per run.
AUTOMATION_MAX_DRAFTS_PER_RUN=10
# Run lease in seconds, renewed after every step; a crashed run's lease expires after this.
AUTOMATION_LEASE_SECONDS=600

# Background worker (python manage.py run_worker): runs sync, AI drafting and Gmail delivery jobs.
WORKER_POLL_SECONDS=1
# A job RUNNING longer than this is treated as abandoned (delivery jobs are then never re-run).
JOB_LOCK_TIMEOUT_SECONDS=900
# Attempts and first retry delay (doubling) for retryable jobs. Gmail delivery is never retried.
JOB_MAX_ATTEMPTS=3
JOB_RETRY_BASE_SECONDS=30

# Collection sequences and approval (M09).
# Reminders at or above this amount (in the invoice's currency) need an APPROVER other than the last editor.
HIGH_VALUE_THRESHOLD=5000
# Minutes between the worker's scheduled sequence ticks (drafts only; never sends).
SEQUENCE_TICK_MINUTES=15
# Hours without a successful sync before the dashboard warns that data may be stale.
STALE_DATA_HOURS=26
# Gemini spending guard for automatic drafting (M09.1). Manual drafts are never blocked, but count.
AI_DAILY_GENERATION_BUDGET=15
AI_QUOTA_BACKOFF_MINUTES=30
AI_RETRY_BASE_MINUTES=15
AI_RETRY_MAX_HOURS=24

# Customer replies (M10). Reading needs the owner's approval of gmail.readonly:
# python manage.py authorize_gmail --with-read-access, then GMAIL_READ_ENABLED=true.
GMAIL_READ_ENABLED=false
INBOX_POLL_MINUTES=5
INBOX_RESCAN_DAYS=30
INBOX_BODY_MAX_CHARS=8000
INBOX_BODY_RETENTION_DAYS=90
REPLY_CONFIDENCE_THRESHOLD=0.8
INBOX_CLASSIFY_MAX_ATTEMPTS=3
OUT_OF_OFFICE_MAX_DAYS=21
OUT_OF_OFFICE_DEFAULT_DAYS=7
